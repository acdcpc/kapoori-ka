# Kapoori Ka — Environment Variables
# Copy this file to .env and fill in your project values.
# For EAS builds, push secrets via: eas env:push --environment preview

APP_NAME=कपूरी क (Kapoori Ka)
APP_VERSION=1.0.0
APP_ENV=development

# ── Supabase (Auth + Database + Storage) — REQUIRED ──
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Firebase (Analytics, Crashlytics, Cloud Messaging, Cloud Functions) ──
# Auth and Firestore are NOT used — Supabase handles those.
# These Firebase vars are still needed for Analytics/Crashlytics/FCM init.
EXPO_PUBLIC_FIREBASE_API_KEY=***
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=1:XXXX:web:XXXX
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXX

# ── OAuth Client IDs (for Firebase Analytics; Google OAuth is via Supabase) ──
EXPO_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_KEY
EXPO_PUBLIC_FIREBASE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_FIREBASE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# App Deep Link Scheme
EXPO_PUBLIC_SCHEME=com.kapoori.ka
